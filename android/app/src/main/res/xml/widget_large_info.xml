<?xml version="1.0" encoding="utf-8"?>
<!-- Großes Widget 4 × 3 (Entwurf 10, Abnahme 30.10.26): zeichnet wie mittel
     (Vertrag Punkt 10), die Zeilen verteilen sich über die Höhe. Takt,
     Wecker und Einstellung wie widget_medium_info.xml. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.example.app.widget.WidgetConfigActivity"
    android:description="@string/widget_large_description"
    android:initialLayout="@layout/widget_root"
    android:minWidth="250dp"
    android:minHeight="180dp"
