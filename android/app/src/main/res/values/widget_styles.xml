<?xml version="1.0" encoding="utf-8"?>
<!-- Startbildschirm-Widget: Schriftstufen des Entwurfs 5 (Abnahme 28.10.26)
     – 12 überall (Kit.barLabel mit 12), fett für Fach und Art, 10 fett für
     den Vornamen unter dem Kürzel. Systemschrift statt Manrope: Ursache
     (Bildschirmfoto Pixel 28.10.26): Schriftdateien aus res/font griffen im
     Widget nicht – der Startbildschirm zeigte normale statt fetter Schrift.
     Jetzt sans-serif-medium bzw. sans-serif fett; Grenze: Schriftbild weicht
     leicht von der App ab. -->
<resources>
    <style name="WidgetText">
        <item name="android:textSize">@dimen/widget_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="WidgetText.Bold">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetName" parent="WidgetText.Bold">
        <item name="android:textSize">@dimen/widget_text_name</item>
    </style>
</resources>
