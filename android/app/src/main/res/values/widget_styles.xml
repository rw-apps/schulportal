<?xml version="1.0" encoding="utf-8"?>
<!-- Startbildschirm-Widget, Entwurf 10 (Abnahme 30.10.26): Schriftstufen des
     Nachbaus (test/_local/widget_v9_mockup_test.dart). w600 → sans-serif-medium,
     w700/w800 → sans-serif fett. Systemschrift statt Manrope: Ursache
     (Bildschirmfoto Pixel 28.10.26): Schriftdateien aus res/font griffen im
     Widget nicht. Grenze: Schriftbild weicht leicht von der App ab; w700 und
     w800 sind beide „fett“. -->
<resources>
    <style name="WidgetText">
        <item name="android:textSize">@dimen/widget_text_12</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="WidgetText.Bold">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- Marke am Symbol (_slot: 10, w800, Farbe card auf der Symbolfarbe). -->
    <style name="WidgetMark" parent="WidgetText.Bold">
        <item name="android:textSize">@dimen/widget_text_10</item>
        <item name="android:textColor">@color/widget_card</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">@dimen/widget_mark</item>
        <item name="android:paddingStart">@dimen/widget_mark_pad</item>
        <item name="android:paddingEnd">@dimen/widget_mark_pad</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Auswahl „Kinder im Widget“ (WidgetConfigActivity): schlichter Dialog
         des Systems, dunkel über values-night/widget_styles.xml. -->
    <style name="WidgetConfigTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
