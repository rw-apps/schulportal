    <!-- Tag-Marke senkrecht: Spalte so breit wie eine Zeile 11 sp, Länge
         reicht für „DONNERSTAG“ (RotatedBox, s. widget_tag.xml). -->
    <dimen name="widget_tag_col">14dp</dimen>
    <dimen name="widget_tag_len">80dp</dimen>
    <!-- Ausfall-Symbol am Zeitraum: Schrift + 4 (_when). -->
