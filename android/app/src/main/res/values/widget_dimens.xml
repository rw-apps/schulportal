<?xml version="1.0" encoding="utf-8"?>
<!-- Startbildschirm-Widget, Entwurf 10 (Abnahme 30.10.26): Maße aus dem
     Flutter-Nachbau test/_local/widget_v9_mockup_test.dart (_strip10, _one41,
     _small2, _oneList, _four42, _four22) und dem Design-Kit (lib/fork/ui/kit.dart,
     Rad). Ursache: Das native Widget kann weder Kit noch Nachbau lesen; die
     Werte stehen deshalb hier EINMAL, die Layouts nehmen nur diese Namen.
     Grenze: Feste Größen ohne Mitwachsen auf Tablets (Entwurf 5 hatte einen
     Maßstab; Entwurf 10 wählt stattdessen die Anordnung nach der Fläche,
     WidgetModel.mode). -->
<resources>
    <!-- Rad.card; ab Android 12 der Radius des Systems (values-v31). -->
    <dimen name="widget_radius">28dp</dimen>
    <!-- Rand: pad 10 (_strip10/_one41/_four42), 12 (_small2/_oneList), 11 (_four22).
         SchoolWidget.kt setzt ihn je Anordnung (setViewPadding). -->
    <dimen name="widget_pad_wide">10dp</dimen>
    <dimen name="widget_pad_small">12dp</dimen>
    <dimen name="widget_pad_grid">11dp</dimen>

    <!-- Feld um ein Symbol: Rad.badge + 2; Marke 16 hoch, Radius 8, 5 dp über
         den Rand hinaus (_slot: Positioned right/top -5). -->
    <dimen name="widget_slot_radius">11dp</dimen>
    <dimen name="widget_mark">16dp</dimen>
    <dimen name="widget_mark_radius">8dp</dimen>
    <dimen name="widget_mark_out">-5dp</dimen>
    <dimen name="widget_mark_pad">4dp</dimen>
    <!-- Symbolgrößen je Anordnung, Symbol im Feld = 0,62 × Feld (_slot). -->
