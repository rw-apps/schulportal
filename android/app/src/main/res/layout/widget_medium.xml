<?xml version="1.0" encoding="utf-8"?>
<!-- Startbildschirm-Widget mittel 4 × 2 (Entwurf 4, Variante A, Abnahme
     28.10.26): Kopf (Schule im Kreis der Kinderfarbe, Datum, Stand), bis zu
     zwei Kacheln mit Abweichungen bzw. die ruhige Fläche „Alles nach Plan“,
     unten Aufgaben, nächste Arbeit und „+N“. Inhalt setzt SchoolWidget.kt.
     Kennung der Wurzel @android:id/background: Ab Android 12 schneidet der
     Startbildschirm daran die Ecken zu. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/head_dot"
                android:layout_width="@dimen/widget_dot"
                android:layout_height="@dimen/widget_dot"
                android:background="@drawable/widget_kid1_dot">

                <ImageView
                    android:id="@+id/head_school"
                    android:layout_width="@dimen/widget_dot_icon"
                    android:layout_height="@dimen/widget_dot_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_school_kid1" />
            </FrameLayout>

            <TextView
                android:id="@+id/head_day"
                style="@style/WidgetText.Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_gap"
                android:layout_weight="1"
                android:textColor="@color/widget_ink" />

            <ImageView
                android:id="@+id/head_sync"
                android:layout_width="@dimen/widget_icon_small"
                android:layout_height="@dimen/widget_icon_small"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_sync" />

            <TextView
                android:id="@+id/head_stand"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_gap_hair"
                android:textColor="@color/widget_faint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_tile_padding"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/calm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_tile_padding"
            android:background="@drawable/widget_kid1_calm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/widget_tile_padding"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/widget_pic"
                android:layout_height="@dimen/widget_pic"
                android:background="@drawable/widget_pic">

                <ImageView
                    android:id="@+id/calm_sun"
                    android:layout_width="@dimen/widget_pic_icon"
                    android:layout_height="@dimen/widget_pic_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_sun_kid1" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_tile_padding"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/calm_title"
                    style="@style/WidgetTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_kid1_on_tint" />

                <TextView
                    android:id="@+id/calm_text"
                    style="@style/WidgetText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_kid1_meta" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/no_data"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_tile_padding"
            android:maxLines="3"
            android:text="@string/widget_no_data"
            android:textColor="@color/widget_muted"
            android:visibility="gone" />

        <!-- Füllt die Höhe, damit die Fußzeile unten steht. FrameLayout statt
             View: RemoteViews lässt nur markierte Klassen zu. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/foot_hw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/widget_foot_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/widget_icon_foot"
                    android:layout_height="@dimen/widget_icon_foot"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_checklist" />

                <TextView
                    android:id="@+id/foot_hw_text"
                    style="@style/WidgetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/widget_gap_tiny"
                    android:textColor="@color/widget_ink" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/foot_exam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/widget_icon_foot"
                    android:layout_height="@dimen/widget_icon_foot"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_edit_note" />

                <TextView
                    android:id="@+id/foot_exam_text"
                    style="@style/WidgetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/widget_gap_tiny"
                    android:textColor="@color/widget_ink" />
            </LinearLayout>

            <TextView
                android:id="@+id/foot_more"
                style="@style/WidgetText.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_gap"
                android:textColor="@color/widget_muted" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
