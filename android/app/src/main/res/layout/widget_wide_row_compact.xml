<?xml version="1.0" encoding="utf-8"?>
<!-- Wie widget_wide_row, aber kleiner (Name 18 sp, Zeitraum 12,5 sp; Symbolspalten 44 dp, Bildschirmfoto 31.10.26: Uhrzeit noch gekürzt), wenn ein Kind im 4 × 2 fünf Symbole hat (Schülerkonto). Ursache (Bildschirmfoto Pixel 30.10.26): Neben fünf großen Symbolen wurde der Name gekürzt („Mar…“) und die Uhrzeit zu „08:00–…“ gekürzt. Beide Zeilen nehmen dieselbe Größe, damit die Kinder gleich aussehen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

    <TextView
        android:id="@+id/name"
        style="@style/WidgetText.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_ink"
        android:textSize="@dimen/widget_text_18" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap_4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/busy"
            android:layout_width="@dimen/widget_busy_16"
            android:layout_height="@dimen/widget_busy_16"
            android:layout_marginEnd="@dimen/widget_gap_3"
            android:src="@drawable/ic_widget_busy"
            android:visibility="gone" />

        <TextView
            android:id="@+id/time"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_text_12_5" />

        <TextView
            android:id="@+id/time_red"
            style="@style/WidgetText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_cancel_strong"
            android:textSize="@dimen/widget_text_12_5"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/mid_busy"
            android:layout_width="@dimen/widget_busy_16"
            android:layout_height="@dimen/widget_busy_16"
            android:layout_marginStart="@dimen/widget_gap_6"
            android:layout_marginEnd="@dimen/widget_gap_2"
            android:src="@drawable/ic_widget_busy"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mid"
            style="@style/WidgetText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textColor="@color/widget_cancel_strong"
            android:textSize="@dimen/widget_text_12_5"
            android:visibility="gone" />

        <TextView
            android:id="@+id/more"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_gap_6"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_text_12_5"
            android:visibility="gone" />
    </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/slots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal" />
</LinearLayout>
