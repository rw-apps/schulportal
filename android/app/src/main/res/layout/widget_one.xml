<?xml version="1.0" encoding="utf-8"?>
<!-- Ein Kind breit (_one41, Leiste und mittel): links Name groß (16), darunter der Zeitraum (12,5); rechts die Symbole mit Beschriftung. Steht neben der Tag-Marke im body (Gewicht 1). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

    <TextView
        android:id="@+id/name"
        style="@style/WidgetText.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_ink"
        android:textSize="@dimen/widget_text_16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap_4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/busy"
            android:layout_width="@dimen/widget_busy_16"
            android:layout_height="@dimen/widget_busy_16"
            android:layout_marginEnd="@dimen/widget_gap_3"
            android:src="@drawable/ic_widget_busy"
            android:visibility="gone" />

        <TextView
            android:id="@+id/time"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_text_12_5" />

        <TextView
            android:id="@+id/time_red"
            style="@style/WidgetText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_cancel_strong"
            android:textSize="@dimen/widget_text_12_5"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/mid_busy"
            android:layout_width="@dimen/widget_busy_16"
            android:layout_height="@dimen/widget_busy_16"
            android:layout_marginStart="@dimen/widget_gap_6"
            android:layout_marginEnd="@dimen/widget_gap_2"
            android:src="@drawable/ic_widget_busy"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mid"
            style="@style/WidgetText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textColor="@color/widget_cancel_strong"
            android:textSize="@dimen/widget_text_12_5"
            android:visibility="gone" />

        <TextView
            android:id="@+id/more"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_gap_6"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_text_12_5"
            android:visibility="gone" />
    </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/slots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal" />
</LinearLayout>
