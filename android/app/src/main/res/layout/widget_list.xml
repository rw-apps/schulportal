<?xml version="1.0" encoding="utf-8"?>
<!-- Ein Kind klein (_oneList, Variante A, abgenommen 30.10.26): Name (14,5) und Tag rechts, Zeitraum (13), unten je Symbol eine Zeile (items). Tippen auf die Fläche → today mit account; zutreffende Zeilen haben ihr eigenes Ziel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

    <TextView
        android:id="@+id/name"
        style="@style/WidgetText.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_ink"
        android:textSize="@dimen/widget_text_14_5"
        android:layout_weight="1" />

        <TextView
            android:id="@+id/tag_inline"
            style="@style/WidgetText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_text_11" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/busy"
            android:layout_width="@dimen/widget_busy_17"
            android:layout_height="@dimen/widget_busy_17"
            android:layout_marginEnd="@dimen/widget_gap_3"
            android:src="@drawable/ic_widget_busy"
            android:visibility="gone" />

        <TextView
            android:id="@+id/time"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_text_13" />

        <TextView
            android:id="@+id/time_red"
            style="@style/WidgetText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_cancel_strong"
            android:textSize="@dimen/widget_text_13"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/mid_busy"
            android:layout_width="@dimen/widget_busy_17"
            android:layout_height="@dimen/widget_busy_17"
            android:layout_marginStart="@dimen/widget_gap_6"
            android:layout_marginEnd="@dimen/widget_gap_2"
            android:src="@drawable/ic_widget_busy"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mid"
            style="@style/WidgetText.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textColor="@color/widget_cancel_strong"
            android:textSize="@dimen/widget_text_13"
            android:visibility="gone" />

        <TextView
            android:id="@+id/more"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_gap_6"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_text_13"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
