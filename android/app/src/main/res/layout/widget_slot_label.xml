<?xml version="1.0" encoding="utf-8"?>
<!-- Beschriftetes Symbol 30 dp (_one41: _slot label: true), Spalte 56 breit (drei Symbole). Beschriftung an = ink fett, blass = faint 60 %; autoSize statt FittedBox (ab Android 8, davor gekürzt); feste Höhe widget_label_h und eine Zeile, sonst schrumpft autoSize nicht – Ursache (Bildschirmfoto Pixel 30.10.26): „Aufgaben“ und „Vertretung“ liefen ineinander. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slot"
    android:layout_width="@dimen/widget_label_col"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="@dimen/widget_slot_30"
        android:layout_height="@dimen/widget_slot_30"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/slot_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/slot_icon"
                android:layout_width="@dimen/widget_icon_30"
                android:layout_height="@dimen/widget_icon_30"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/slot_mark"
            style="@style/WidgetMark"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/widget_mark"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/widget_mark_out"
            android:layout_marginEnd="@dimen/widget_mark_out"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/slot_label_on"
        style="@style/WidgetText.Bold"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_label_h"
        android:layout_marginTop="@dimen/widget_gap_3"
        android:maxLines="1"
        android:paddingStart="@dimen/widget_gap_1"
        android:paddingEnd="@dimen/widget_gap_1"
        android:autoSizeMaxTextSize="@dimen/widget_text_10"
        android:autoSizeMinTextSize="@dimen/widget_text_8"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/widget_ink"
        android:textSize="@dimen/widget_text_10"
        android:visibility="gone" />

    <TextView
        android:id="@+id/slot_label_off"
        style="@style/WidgetText"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_label_h"
        android:layout_marginTop="@dimen/widget_gap_3"
        android:maxLines="1"
        android:paddingStart="@dimen/widget_gap_1"
        android:paddingEnd="@dimen/widget_gap_1"
        android:autoSizeMaxTextSize="@dimen/widget_text_10"
        android:autoSizeMinTextSize="@dimen/widget_text_8"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/widget_faint_label"
        android:textSize="@dimen/widget_text_10" />
</LinearLayout>
