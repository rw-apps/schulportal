<?xml version="1.0" encoding="utf-8"?>
<!-- Startbildschirm-Widget klein 2 × 2 (Entwurf 4, Variante B, Abnahme
     28.10.26): die dringendste Abweichung als Kachel bzw. die ruhige Fläche
     (untereinander), unten die offenen Aufgaben. Statt des Kopfs nur der
     Vorname. Kennungen wie widget_medium.xml (SchoolWidget.kt). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Vorname des Kindes (Rückmeldung 28.10.26), SchoolWidget.kt. -->
        <TextView
            android:id="@+id/head_name"
            style="@style/WidgetText.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/widget_gap"
            android:textColor="@color/widget_ink"
            android:visibility="gone" />

        <!-- Kachel füllt die Höhe (Bildschirmfoto Pixel 28.10.26: sonst
             leerer Raum unter der Kachel); die Füllfläche unten ist dann
             aus (SchoolWidget.kt, R.id.fill). -->
        <LinearLayout
            android:id="@+id/tiles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/calm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_kid1_calm"
            android:orientation="vertical"
            android:padding="@dimen/widget_tile_padding"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/widget_pic"
                android:layout_height="@dimen/widget_pic"
                android:background="@drawable/widget_pic">

                <ImageView
                    android:id="@+id/calm_sun"
                    android:layout_width="@dimen/widget_pic_icon"
                    android:layout_height="@dimen/widget_pic_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_sun_kid1" />
            </FrameLayout>

            <TextView
                android:id="@+id/calm_title"
                style="@style/WidgetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_gap_small"
                android:maxLines="2"
                android:textColor="@color/widget_kid1_on_tint" />

            <TextView
                android:id="@+id/calm_text"
                style="@style/WidgetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/widget_kid1_meta" />
        </LinearLayout>

        <TextView
            android:id="@+id/no_data"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:text="@string/widget_no_data"
            android:textColor="@color/widget_muted"
            android:visibility="gone" />

        <!-- Füllt die Höhe (FrameLayout statt View, siehe widget_medium). -->
        <FrameLayout
            android:id="@+id/fill"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/foot_hw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/widget_icon_foot"
                android:layout_height="@dimen/widget_icon_foot"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_checklist" />

            <TextView
                android:id="@+id/foot_hw_text"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_gap_tiny"
                android:textColor="@color/widget_ink" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
