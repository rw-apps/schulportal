<?xml version="1.0" encoding="utf-8"?>
<!-- Ein Kind als Zeile (Entwurf 5, _Kid; 2 Kinder, groß ab 3 Kindern): links
     Kürzel im Kreis der Kinderfarbe und Vorname (10 sp), rechts die Kacheln
     (Reihen zu zwei, SchoolWidget.kt kidRow). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/kid_col"
        android:layout_width="@dimen/widget_avatar_col"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/widget_gap_tiny">

        <FrameLayout
            android:id="@+id/kid_avatar"
            android:layout_width="@dimen/widget_avatar"
            android:layout_height="@dimen/widget_avatar"
            android:background="@drawable/widget_kid0_dot">

            <TextView
                android:id="@+id/kid_initial"
                style="@style/WidgetText.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/widget_on_strong" />
        </FrameLayout>

        <TextView
            android:id="@+id/kid_name"
            style="@style/WidgetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_gap_hair"
            android:textColor="@color/widget_ink" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/kid_tiles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/widget_gap_tiny"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
