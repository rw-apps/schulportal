<?xml version="1.0" encoding="utf-8"?>
<!-- Kompakte Zelle „Stand Fr 18:05“, grau (TileKind.STALE, Prüfung 28.10.26): der
     Vertretungsplan deckt heute nicht mehr ab (WidgetModel.quietTile).
     Kompakte Zelle ab drei Kindern (Entwurf 5, _Compact): Lagebild im Kreis,
     Zeile 1 Punkt in der Kinderfarbe + „Name · Fach“ (fett), Zeile 2 die Art
     im Klartext („fällt aus morgen“). Inhalt setzt SchoolWidget.kt (cell). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_bg"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/widget_tile_info"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/widget_tile_pad_h"
    android:paddingTop="@dimen/widget_cell_pad_v"
    android:paddingEnd="@dimen/widget_tile_pad_h"
    android:paddingBottom="@dimen/widget_cell_pad_v">

    <FrameLayout
        android:id="@+id/cell_circle"
        android:layout_width="@dimen/widget_circle"
        android:layout_height="@dimen/widget_circle"
        android:background="@drawable/widget_circle_todo">

        <ImageView
            android:id="@+id/cell_icon"
            android:layout_width="@dimen/widget_circle_icon"
            android:layout_height="@dimen/widget_circle_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_stale" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/cell_text"
        android:layout_marginStart="@dimen/widget_gap_small"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/cell_dot"
                android:layout_width="@dimen/widget_dot_small"
                android:layout_height="@dimen/widget_dot_small"
                android:background="@drawable/widget_kid0_dot" />

            <TextView
                android:id="@+id/cell_l1"
                style="@style/WidgetText.Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_gap_tiny"
                android:layout_weight="1"
                android:textColor="@color/widget_ink" />
        </LinearLayout>

        <TextView
            android:id="@+id/cell_l2"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_ink" />
    </LinearLayout>
</LinearLayout>
