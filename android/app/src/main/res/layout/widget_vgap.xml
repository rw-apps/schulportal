<?xml version="1.0" encoding="utf-8"?>
<!-- Senkrechter Abstand Sp.s (zwischen Kindern). FrameLayout statt View: RemoteViews lässt nur markierte Klassen zu.
     Höhe als Innenabstand statt fester Höhe: Ursache (Foto Tablet 28.10.26):
     Auf Tablets wächst der Abstand mit dem Maßstab (SchoolWidget.kt, gap);
     setViewPadding geht auf jedem Android, setViewLayoutHeight erst ab 12. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/widget_gap" />
