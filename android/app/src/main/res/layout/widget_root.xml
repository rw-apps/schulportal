<?xml version="1.0" encoding="utf-8"?>
<!-- Startbildschirm-Widget, Entwurf 10 (Abnahme 30.10.26), Wurzel für alle
     Anordnungen: body (waagerecht; SchoolWidget.kt hängt Tag-Marke und
     Kind-Zeilen bzw. die Spalte der kleinen Anordnungen an), corner_day (Tag
     klein rechts oben, nur _small2) und no_data (keine Datei oder Version ≠ 3).
     Kennung @android:id/background: Ab Android 12 schneidet der
     Startbildschirm daran die Ecken zu. clipChildren/clipToPadding aus:
     Ursache: Die Marke am Symbol ragt 5 dp über ihr Feld hinaus (_slot,
     Positioned -5) und die gedrehte Tag-Marke über ihre Spalte
     (widget_tag.xml); beides läge sonst abgeschnitten. Grenze: Über den Rand
     der Karte hinaus zeichnet der Startbildschirm trotzdem nicht. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/widget_pad_wide">

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/corner_day"
        style="@style/WidgetText.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:textColor="@color/widget_muted"
        android:textSize="@dimen/widget_text_11"
        android:visibility="gone" />

    <TextView
        android:id="@+id/no_data"
        style="@style/WidgetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:maxLines="4"
        android:text="@string/widget_no_data"
        android:textColor="@color/widget_muted"
        android:visibility="gone" />
</FrameLayout>
