<?xml version="1.0" encoding="utf-8"?>
<!-- Kachel „Vertretung“/„Raumwechsel“ (Entwurf 4, _Tile), gelb. Das
     Lagebild setzt SchoolWidget.kt: andere Lehrkraft (Vertretung, „bitte
     prüfen“) bzw. Fußgänger (Raumwechsel). Sonst wie
     widget_tile_cancel.xml, gleiche Kennungen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/widget_tile_change"
    android:orientation="vertical"
    android:padding="@dimen/widget_tile_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/widget_pic"
            android:layout_height="@dimen/widget_pic"
            android:background="@drawable/widget_pic">

            <ImageView
                android:id="@+id/tile_icon"
                android:layout_width="@dimen/widget_pic_icon"
                android:layout_height="@dimen/widget_pic_icon"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_switch_account" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_gap_tiny"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tile_when"
                style="@style/WidgetText.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_change_ink" />

            <TextView
                android:id="@+id/tile_slot"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_change_ink" />
        </LinearLayout>
    </LinearLayout>

    <!-- Füllt eine hohe Kachel (klein 2 × 2): Bild oben, Text unten
         (Bildschirmfoto Pixel 28.10.26). In der mittleren Größe ohne
         Wirkung, dort ist die Kachel so hoch wie ihr Inhalt. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tile_title"
        style="@style/WidgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap_small"
        android:textColor="@color/widget_change_ink" />

    <TextView
        android:id="@+id/tile_what"
        style="@style/WidgetText.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_change_ink" />

    <TextView
        android:id="@+id/tile_detail"
        style="@style/WidgetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_change_ink" />
</LinearLayout>
